# ==========================================
# INBARE — Server Environment Variables
# ==========================================
# Copy this file to .env and fill in values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (Railway auto-sets DATABASE_URL)
# For local dev with SQLite, leave DATABASE_URL empty
DATABASE_URL=

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=7d

# CORS (set to your Vercel frontend URL in production)
CORS_ORIGIN=http://localhost:5173

# Client URL (for email links)
CLIENT_URL=http://localhost:5173

# Admin seed credentials
ADMIN_EMAIL=admin@inbare.com
ADMIN_PASSWORD=admin123

# Email (SMTP / Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@inbare.com
